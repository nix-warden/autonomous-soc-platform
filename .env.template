# ==============================================================================
# AUTONOMOUS SOC PLATFORM - GLOBAL CONFIGURATION
# ==============================================================================
# Enterprise best practice: Do not commit the actual .env file to version 
# control. This .env.template file serves as a reference. Copy it to .env 
# and modify the values according to your target environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PLATFORM MODULES (COMPOSE PROFILES)
# ------------------------------------------------------------------------------
# Select which components of the platform to run.
# Leave empty to run only the Core (SIEM). 
# Example: COMPOSE_PROFILES=soar,forensics
# ------------------------------------------------------------------------------
COMPOSE_PROFILES=

# ------------------------------------------------------------------------------
# 2. COMPONENT VERSIONS
# ------------------------------------------------------------------------------
# Pin versions to ensure reproducible and stable deployments across environments.
# ------------------------------------------------------------------------------
# SIEM (Wazuh)
WAZUH_VERSION=4.14.4
WAZUH_CERT_TOOL_VERSION=4.14

# SOAR (StackStorm)
ST2_VERSION=3.9.0

# Forensics (DFIR IRIS)
IRIS_VERSION=v2.4.27

# ------------------------------------------------------------------------------
# 3. GLOBAL NETWORK SETTINGS
# ------------------------------------------------------------------------------
# Core networking configuration for reverse proxies, DNS, and service routing.
# ------------------------------------------------------------------------------
DOMAIN_NAME=soc.local

# ------------------------------------------------------------------------------
# 4. SECURITY & CREDENTIALS
# ------------------------------------------------------------------------------
# ! WARNING: CRITICAL SECURITY NOTICE
# The passwords provided below are DEFAULTS from the official documentation
# of the respective services. They are provided ONLY to facilitate a seamless
# initial setup and testing of the integrated platform.
# 
# MUST ACTION: You MUST change these passwords before deploying this platform 
# to a production environment, or if you detach and expose these services 
# independently.
# ------------------------------------------------------------------------------
WAZUH_INDEXER_PASSWORD=SecretPassword
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
WAZUH_DASHBOARD_PASSWORD=kibanaserver

# ------------------------------------------------------------------------------
# 5. RESOURCE LIMITS & TUNING
# ------------------------------------------------------------------------------
# Hardware allocation limits for containerized services. Adjust these based 
# on the available resources of your deployment node.
# ------------------------------------------------------------------------------
# Wazuh Indexer (OpenSearch)
# WAZUH_INDEXER_HEAP should ideally be 50% of the total memory allocated.
WAZUH_INDEXER_HEAP=1g
WAZUH_INDEXER_MEM_LIMIT=4G

# Wazuh Manager
WAZUH_MANAGER_MEM_LIMIT=4G

# Wazuh Dashboard
WAZUH_DASHBOARD_MEM_LIMIT=2G
